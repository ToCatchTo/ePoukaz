# Dev proxy: nech PRÁZDNÉ → frontend volá same-origin /api/..., které Vite proxy
# (vite.config.ts) přepošle na API. Plná URL by v prohlížeči narazila na CORS.
VITE_API_BASE_URL=
# Token od backend kolegy. NENÍ VITE_ prefixovaný → čte ho jen dev proxy na serveru,
# do prohlížeče se nedostane. Zkopíruj tento soubor do .env a doplň hodnotu. NECOMMITUJ token.
API_TOKEN=
